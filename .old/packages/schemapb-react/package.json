{
  "name": "@stroppy-io/schemapb-react",
  "version": "0.0.1",
  "description": "Headless React hook for building forms from a schemapb schema — bring your own components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stroppy-io/schemapb.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "pretest": "cd ../schemapb && npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@stroppy-io/schemapb": "*",
    "react": ">=18"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@stroppy-io/schemapb": "*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
