{
  "name": "@gopherex/schemapb",
  "version": "0.0.0",
  "description": "schemapb — proto-defined form/config schema descriptor: native TypeScript implementation (validation, CEL computed values, Mustache rendering)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopherex/schemapb.git",
    "directory": "ts"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "yarn@4.10.3",
  "dependencies": {
    "@bufbuild/cel": "0.6.0",
    "@bufbuild/protobuf": "^2.11.0",
    "mustache": "^4.2.0",
    "semver": "^7.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
