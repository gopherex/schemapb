{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["react", "node"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["index.ts", "useSchemaForm.ts", "helpers.ts", "*.test.ts", "*.test.tsx"]
}
